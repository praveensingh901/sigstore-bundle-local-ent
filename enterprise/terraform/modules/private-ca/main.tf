# AWS Private CA subordinate for internal TLS (*.sigstore.corp.example).
# The CA is created in PENDING_CERTIFICATE state; its CSR is signed by the
# corporate offline root during the ceremony and imported with
# `aws acm-pca import-certificate-authority-certificate` (see
# enterprise/docs/02-pki-and-ceremony.md §5). Terraform does not hold the root.
#
# Name constraints cannot be requested by AWS Private CA for its own CA
# certificate; the offline root adds them when it signs (openssl-profiles.cnf
# [tls_subordinate]).

terraform {
  required_version = ">= 1.13.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0, < 7.0"
    }
  }
}

data "aws_caller_identity" "current" {}

resource "aws_s3_bucket" "crl" {
  #checkov:skip=CKV_AWS_18:CRL bucket (optional, off by default) holds only public CRLs.
  #checkov:skip=CKV_AWS_144:CRLs are regenerated by the CA; replication adds nothing.
  #checkov:skip=CKV_AWS_145:AWS Private CA writes CRLs with SSE-S3.
  #checkov:skip=CKV2_AWS_62:No consumers of event notifications.
  #checkov:skip=CKV2_AWS_61:Versioned CRLs; a lifecycle rule is optional.
  count         = var.enable_crl ? 1 : 0
  bucket        = var.crl_bucket_name
  force_destroy = false
  tags          = var.tags
}

resource "aws_s3_bucket_public_access_block" "crl" {
  count                   = var.enable_crl ? 1 : 0
  bucket                  = aws_s3_bucket.crl[0].id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "crl" {
  count  = var.enable_crl ? 1 : 0
  bucket = aws_s3_bucket.crl[0].id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "crl" {
  count  = var.enable_crl ? 1 : 0
  bucket = aws_s3_bucket.crl[0].id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256" # AWS Private CA cannot write CRLs to SSE-KMS buckets with customer keys unless granted; keep SSE-S3.
    }
  }
}

data "aws_iam_policy_document" "crl" {
  count = var.enable_crl ? 1 : 0
  statement {
    sid       = "AllowPCAWriteCRL"
    actions   = ["s3:PutObject", "s3:PutObjectAcl", "s3:GetBucketAcl", "s3:GetBucketLocation"]
    resources = [aws_s3_bucket.crl[0].arn, "${aws_s3_bucket.crl[0].arn}/*"]
    principals {
      type        = "Service"
      identifiers = ["acm-pca.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [data.aws_caller_identity.current.account_id]
    }
  }

  statement {
    sid       = "DenyInsecureTransport"
    effect    = "Deny"
    actions   = ["s3:*"]
    resources = [aws_s3_bucket.crl[0].arn, "${aws_s3_bucket.crl[0].arn}/*"]
    principals {
      type        = "*"
      identifiers = ["*"]
    }
    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_policy" "crl" {
  count  = var.enable_crl ? 1 : 0
  bucket = aws_s3_bucket.crl[0].id
  policy = data.aws_iam_policy_document.crl[0].json
}

resource "aws_acmpca_certificate_authority" "tls" {
  type       = "SUBORDINATE"
  usage_mode = "GENERAL_PURPOSE"

  certificate_authority_configuration {
    key_algorithm     = "EC_secp384r1" # gitleaks:allow (algorithm name)
    signing_algorithm = "SHA384WITHECDSA"
    subject {
      common_name         = var.common_name
      organization        = var.organization
      organizational_unit = "Platform PKI"
      country             = var.country
    }
  }

  # CRL publication is off by default: this CA issues only TLS server
  # certificates (ACM, 13 months; cert-manager, 90 days) and nothing serves
  # the CRL name inside the network. If enabled, publish the bucket behind
  # var.crl_cname (e.g. private CloudFront or an internal web server) first,
  # or strict revocation-checking clients will fail.
  dynamic "revocation_configuration" {
    for_each = var.enable_crl ? [1] : []
    content {
      crl_configuration {
        enabled            = true
        expiration_in_days = 7
        s3_bucket_name     = aws_s3_bucket.crl[0].id
        s3_object_acl      = "BUCKET_OWNER_FULL_CONTROL"
        custom_cname       = var.crl_cname
      }
    }
  }

  permanent_deletion_time_in_days = 30
  tags                            = var.tags

  depends_on = [aws_s3_bucket_policy.crl]
}

# No aws_acmpca_permission for acm.amazonaws.com: ACM certificates are
# requested in the recipient (Sigstore) accounts through the RAM share, and
# their renewal runs under ACM's service-linked role there.

# Share with the Sigstore platform accounts through AWS RAM (ACM for the ALB,
# cert-manager aws-privateca-issuer for pod certificates). The default
# managed permission is used; keep cert-manager Certificate usages at their
# defaults so the issuer selects the EndEntityCertificate/V1 template, or pin
# permission_arns to a managed permission that allows the template you need.
resource "aws_ram_resource_share" "pca" {
  count                     = length(var.share_with_principals) > 0 ? 1 : 0
  name                      = "sigstore-tls-pca"
  allow_external_principals = false
  tags                      = var.tags
}

resource "aws_ram_resource_association" "pca" {
  count              = length(var.share_with_principals) > 0 ? 1 : 0
  resource_arn       = aws_acmpca_certificate_authority.tls.arn
  resource_share_arn = aws_ram_resource_share.pca[0].arn
}

resource "aws_ram_principal_association" "pca" {
  for_each           = toset(var.share_with_principals)
  principal          = each.value
  resource_share_arn = aws_ram_resource_share.pca[0].arn
}
